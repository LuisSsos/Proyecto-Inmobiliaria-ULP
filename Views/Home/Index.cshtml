@{
    ViewData["Title"] = "Inicio";
}

<!-- portada -->
<div class="container-fluid py-2 mb-2 seccion-luvarem">

    <div class="container text-center py-5">

        <h1 class="display-2 fw-bold titulo-luvarem">
            Inmobiliaria Luvarem
        </h1>

        <p class="display-6 texto-luvarem">
            Encontrá la casa de tus sueños uwu
        </p>

    </div>

</div>


<!-- ppciones -->
<div class="container mb-5" id="opciones">



    <div class="row g-4">

        <!-- propietarios -->
        <div class="col-md-6">

            <div class="card h-100 text-center">

                <div class="card-body p-5">

                    <h3 class="card-title">
                        Propietarios
                    </h3>

                    <p class="card-text">
                        Consultá la información de los propietarios
                        registrados en nuestra inmobiliaria.
                    </p>

                    <a asp-controller="Propietario" asp-action="Index" class="btn btn-luvarem mt-2">
                        Ver propietarios
                    </a>

                </div>

            </div>

        </div>


        <!-- inquilinos -->
        <div class="col-md-6">

            <div class="card h-100 text-center">

                <div class="card-body p-5">

                    <h3 class="card-title">
                        Inquilinos
                    </h3>

                    <p class="card-text">
                        Consultá la información de los inquilinos
                        registrados en nuestra inmobiliaria.
                    </p>

                    <a asp-controller="Inquilino" asp-action="Index" class="btn btn-luvarem mt-2">
                        Ver inquilinos
                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-6">

            <div class="card h-100 text-center">

                <div class="card-body p-5">

                    <h3 class="card-title">
                        Inmuebles
                    </h3>

                    <p class="card-text">
                        Consultá la información de los inmuebles
                        registrados en nuestra inmobiliaria.
                    </p>

                    <a asp-controller="Inmueble" asp-action="Index" class="btn btn-luvarem mt-2">
                        Ver inmuebles
                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-6">

            <div class="card h-100 text-center">

                <div class="card-body p-5">

                    <h3 class="card-title">
                        Reservas
                    </h3>

                    <p class="card-text">
                        Consultá la información de las reservas
                        registradas en nuestra inmobiliaria.
                    </p>

                    <a asp-controller="Reserva" asp-action="Index" class="btn btn-primary">
                        Reservas
                    </a>

                </div>

            </div>

        </div>
    </div>

        
    

