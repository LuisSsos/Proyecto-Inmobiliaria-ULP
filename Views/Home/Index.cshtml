@{
    ViewData["Title"] = "Inicio";
}

<!-- portada -->
<div class="container-fluid py-5 mb-5 seccion-luvarem">

    <div class="container text-center py-5">

        <h1 class="display-2 fw-bold titulo-luvarem">
            Inmobiliaria Luvarem
        </h1>

        <p class="display-6 texto-luvarem">
            Encontrá la casa de tus sueños uwu
        </p>

        <a href="#opciones" class="btn btn-lg btn-luvarem">
            Ver opciones
        </a>

    </div>

</div>


<!-- ppciones -->
<div class="container mb-5" id="opciones">

    <div class="text-center mb-4">

        <h2 class="fw-bold titulo-luvarem">
            Nuestra inmobiliaria
        </h2>

        <p class="texto-luvarem">
            Conocé nuestras opciones
        </p>

    </div>


    <div class="row g-4">

        <!-- propietarios -->
        <div class="col-md-6">

            <div class="card h-100 text-center">

                <div class="card-body p-5">

                    <h3 class="card-title">
                        Propietarios
                    </h3>

                    <p class="card-text">
                        Consultá la información de los propietarios
                        registrados en nuestra inmobiliaria.
                    </p>

                    <a asp-controller="Propietario"
                       asp-action="Index"
                       class="btn btn-luvarem mt-2">
                        Ver propietarios
                    </a>

                </div>

            </div>

        </div>


        <!-- inquilinos -->
        <div class="col-md-6">

            <div class="card h-100 text-center">

                <div class="card-body p-5">

                    <h3 class="card-title">
                        Inquilinos
                    </h3>

                    <p class="card-text">
                        Consultá la información de los inquilinos
                        registrados en nuestra inmobiliaria.
                    </p>

                    <a asp-controller="Inquilino"
                       asp-action="Index"
                       class="btn btn-luvarem mt-2">
                        Ver inquilinos
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- presentación -->
<div class="container-fluid py-5 seccion-luvarem">

    <div class="container text-center">

        <h2 class="fw-bold titulo-luvarem">
            Inmobiliaria Luvarem
        </h2>

        <p class="lead texto-luvarem">
            Tu próximo hogar puede estar más cerca de lo que imaginás.
        </p>

    </div>

</div>