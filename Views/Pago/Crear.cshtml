@model MVC.Models.Pago

@{
    ViewData["Title"] = "Nuevo pago";
}

<div class="container mt-4">

    <h1>Nuevo pago</h1>

    <form asp-action="Crear" method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="ReservaId" class="form-label">Reserva</label>
            <select asp-for="ReservaId" class="form-select">
                <option value="">Seleccione una reserva</option>

                @foreach (var reserva in ViewBag.Reservas)
                {
                    <option value="@reserva.id_reserva">
                        Reserva #@reserva.id_reserva -
                        @reserva.fecha_desde.ToString("dd/MM/yyyy") -
                        @reserva.fecha_hasta.ToString("dd/MM/yyyy")
                    </option>
                }
            </select>
            <span asp-validation-for="ReservaId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="concepto" class="form-label">Concepto</label>
            <select asp-for="concepto" class="form-select">
                <option value="">Seleccione un concepto</option>
                <option value="Alquiler">Alquiler</option>
                <option value="Seña">Seña</option>
                <option value="Pago de reserva">Pago de reserva</option>
                <option value="Adelanto">Adelanto</option>
            </select>
            <span asp-validation-for="concepto" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="fecha_pago" class="form-label">Fecha de pago</label>
            <input asp-for="fecha_pago" type="date" class="form-control" />
            <span asp-validation-for="fecha_pago" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="importe" class="form-label">Importe</label>
            <input asp-for="importe" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="importe" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Registrar pago
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Volver
        </a>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}