@model List<MVC.Models.Usuario>

<h2>Usuarios</h2>

<a asp-action="Crear">Nuevo usuario</a>

<table border="1">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Email</th>
            <th>Rol</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var usuario in Model)
        {
            <tr>
                <td>@usuario.id_usuario</td>
                <td>@usuario.nombre</td>
                <td>@usuario.apellido</td>
                <td>@usuario.email</td>
                <td>@usuario.rol</td>
                <td>
                    <a asp-action="Editar" asp-route-id="@usuario.id_usuario">Editar</a>
                    <a asp-action="Eliminar" asp-route-id="@usuario.id_usuario">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>