@model MVC.Models.Inquilino

<h2>Nuevo Inquilino</h2>

<div asp-validation-summary="All" style="color:red"></div>

<form asp-action="Create" method="post">

    <div>
        <label asp-for="nombre_completo">Nombre completo</label>
        <input asp-for="nombre_completo" />
        <span asp-validation-for="nombre_completo" style="color:red"></span>
    </div>

    <div>
        <label asp-for="dni">DNI</label>
        <input asp-for="dni" />
        <span asp-validation-for="dni" style="color:red"></span>
    </div>

    <div>
        <label asp-for="email">Email</label>
        <input asp-for="email" />
        <span asp-validation-for="email" style="color:red"></span>
    </div>

    <div>
        <label asp-for="telefono">Teléfono</label>
        <input asp-for="telefono" />
        <span asp-validation-for="telefono" style="color:red"></span>
    </div>

    <button type="submit">Guardar</button>

    <a asp-action="Index">Volver</a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}