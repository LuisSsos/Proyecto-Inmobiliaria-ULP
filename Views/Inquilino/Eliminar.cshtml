@model MVC.Models.Inquilino

<h2>Eliminar inquilino</h2>

<p>¿Estás seguro que querés eliminar este inquilino?</p>

<div>
    <strong>Nombre:</strong> @Model.nombre_completo
</div>
<div>
    <strong>DNI:</strong> @Model.dni
</div>
<div>
    <strong>Email:</strong> @Model.email
</div>

<form asp-action="Eliminar" method="post">
    <input type="hidden" asp-for="id_inquilino" />
    <button type="submit">Sí, eliminar</button>
    <a asp-action="Index">Cancelar</a>
</form>