@model MVC.Models.Inquilino

<h2>Editar inquilino</h2>

<div asp-validation-summary="All" style="color:red"></div>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="id_inquilino" />
    <div>
        <label>Nombre completo</label>
        <input asp-for="nombre_completo" />
        <span asp-validation-for="nombre_completo" style="color:red"></span>
    </div>
    <div>
        <label>DNI</label>
        <input asp-for="dni" />
        <span asp-validation-for="dni" style="color:red"></span>
    </div>
    <div>
        <label>Email</label>
        <input asp-for="email" />
        <span asp-validation-for="email" style="color:red"></span>
    </div>
    <div>
        <label>Teléfono</label>
        <input asp-for="telefono" />
        <span asp-validation-for="telefono" style="color:red"></span>
    </div>
    <button type="submit">Guardar cambios</button>
</form>
