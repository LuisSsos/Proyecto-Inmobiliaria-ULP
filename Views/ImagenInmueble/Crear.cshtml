@{
    ViewData["Title"] = "Agregar Imagen";
}

<div class="container mt-4">
    <h2 class="text-primary mb-4">Agregar imagen</h2>

    <div asp-validation-summary="All" class="alert alert-danger" style="display: none;" id="validationSummary"></div>

    <div class="card shadow-sm" style="max-width: 400px;">
        <div class="card-body">
            <form asp-action="Crear" method="post" enctype="multipart/form-data">
                <input type="hidden" name="inmuebleId" value="@ViewBag.InmuebleId" />

                <div class="mb-3">
                    <label class="form-label">Imagen</label>
                    <input type="file" name="archivo" accept="image/*" class="form-control" />
                </div>

                <div class="mb-3 form-check">
                    <input type="checkbox" name="esPortada" value="true" class="form-check-input" id="esPortadaCheck" />
                    <label class="form-check-label" for="esPortadaCheck">Marcar como portada</label>
                </div>

                <button type="submit" class="btn btn-success">Subir</button>
                <a asp-action="Index" asp-route-inmuebleId="@ViewBag.InmuebleId" class="btn btn-outline-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>