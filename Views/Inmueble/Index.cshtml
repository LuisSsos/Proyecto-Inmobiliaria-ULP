@model IEnumerable<MVC.Models.Inmueble>

@{
    ViewData["Title"] = "Listado de Inmuebles";
}

<h2>Listado de Inmuebles</h2>

<p>
    <a asp-action="Crear" class="btn btn-primary">Nuevo inmueble</a>
    <a asp-action="MasReservados" class="btn btn-primary">Inmuebles más reservados</a>
</p>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<form asp-action="Index" method="get" class="mb-3">

    <div class="row align-items-end">

        <div class="col-md-4">
            <label for="estado" class="form-label">
                Filtrar por estado
            </label>

            <select name="estado" id="estado" class="form-select">

                <option value="">
                    Todos
                </option>

                <option value="Disponible" selected="@(ViewBag.EstadoActual == "Disponible")">
                    Disponible
                </option>

                <option value="Suspendido" selected="@(ViewBag.EstadoActual == "Suspendido")">
                    Suspendido
                </option>

            </select>
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-primary">
                Filtrar
            </button>
        </div>

    </div>

    <div class="mb-3">
        <label for="buscarPropietario" class="form-label">
            Propietario
        </label>

        <input type="text" id="buscarPropietario" class="form-control" placeholder="Escriba al menos 2 caracteres..."
               autocomplete="off" />

        <div id="resultadosPropietarios" class="list-group mt-1">
        </div>

        <input type="hidden" id="propietarioId" name="propietarioId" />
    </div>

</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Imagen</th>
            <th>Dirección</th>
            <th>Cupo</th>
            <th>Precio por día</th>
            <th>Porcentaje de seña</th>
            <th>Estado</th>
            <th>Propietario</th>
            <th>Tipo</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var imagenes = ViewBag.ImagenesPorInmueble as Dictionary<int, MVC.Models.ImagenInmueble>;
            MVC.Models.ImagenInmueble? portada = null;
            imagenes?.TryGetValue(item.IdInmueble, out portada);

            <tr>
                <td>
                    @if (portada != null)
                    {
                        <img src="@portada.url" width="80" />
                    }
                    else
                    {
                        <span>Sin imagen</span>
                    }
                </td>
                <td>@item.Direccion</td>
                <td>@item.Cupo</td>
                <td>@item.PrecioPorDia.ToString("C")</td>
                <td>@item.PorcentajeSeña%</td>
                <td>@item.Estado</td>
                <td>@(item.Titular != null ? item.Titular.Nombre : "Sin propietario asignado")</td>
                <td>@(item.Tipo != null ? item.Tipo.Nombre : "Sin especificar")</td>
                <td>
                    <a asp-action="Editar" asp-route-id="@item.IdInmueble">Editar</a> |
                    <a asp-action="Eliminar" asp-route-id="@item.IdInmueble">Eliminar</a> |
                    @if (item.Estado != "Suspendido")
                    {
                        <a asp-controller="Reserva" asp-action="Crear" asp-route-inmuebleId="@item.IdInmueble">Reservar</a>
                        
                    }
                    <form asp-action="CambiarEstado" asp-route-id="@item.IdInmueble" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-sm btn-danger">
                            @(item.Estado == "Suspendido" ? "Reactivar" : "Suspender")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (ViewBag.TotalPaginas > 1)
{
    <nav>
        <ul class="pagination">

            @if (ViewBag.PaginaActual > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(ViewBag.PaginaActual - 1)"
                       asp-route-estado="@ViewBag.EstadoActual">
                        Anterior
                    </a>
                </li>
            }

            @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
            {
                <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">

                    <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-estado="@ViewBag.EstadoActual">
                        @i
                    </a>

                </li>
            }

            @if (ViewBag.PaginaActual < ViewBag.TotalPaginas)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(ViewBag.PaginaActual + 1)"
                       asp-route-estado="@ViewBag.EstadoActual">
                        Siguiente
                    </a>
                </li>
            }

        </ul>
    </nav>
}

<script>
        const inputPropietario =
            document.getElementById("buscarPropietario");

        const resultados =
            document.getElementById("resultadosPropietarios");

        const propietarioId =
            document.getElementById("propietarioId");

        inputPropietario.addEventListener("input", async function () {

            const texto = this.value.trim();

            resultados.innerHTML = "";
            propietarioId.value = "";

            if (texto.length < 2) {
                return;
            }

            try {

                const respuesta = await fetch(
                    `/Inmueble/BuscarPropietarios?texto=${encodeURIComponent(texto)}`
                );

                if (!respuesta.ok) {
                    throw new Error("Error al buscar propietarios.");
                }

                const propietarios = await respuesta.json();

                console.log("Propietarios encontrados:", propietarios);

                propietarios.forEach(propietario => {

                    const opcion = document.createElement("button");

                    opcion.type = "button";
                    opcion.className =
                        "list-group-item list-group-item-action";

                    opcion.innerHTML = `
                        <strong>${propietario.nombre}</strong>
                        <br>
                        <small>DNI/CUIT: ${propietario.dniCuit}</small>
                    `;

                    opcion.addEventListener("click", function () {

                        inputPropietario.value =
                            propietario.nombre;

                        propietarioId.value =
                            propietario.id;

                        resultados.innerHTML = "";
                    });

                    resultados.appendChild(opcion);
                });

            } catch (error) {

                console.error("Error:", error);
            }
        });
    </script>