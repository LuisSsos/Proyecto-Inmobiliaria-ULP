@model MVC.Models.Reserva

@{
    ViewData["Title"] = "Terminar Anticipadamente";
}

<h1>Terminar Reserva Anticipadamente</h1>

<form asp-action="TerminarAnticipado" method="post">
    <input type="hidden" asp-for="id_reserva" />

    <div class="mb-3">
        <label class="form-label">Fecha de Terminación Real</label>
        <input asp-for="fecha_fin_real" type="date" class="form-control" 
               min="@Model.fecha_desde.ToString("yyyy-MM-dd")" 
               max="@Model.fecha_hasta.ToString("yyyy-MM-dd")" required />
        <span asp-validation-for="fecha_fin_real" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Multa Aplicada ($)</label>
        <input asp-for="multa" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="multa" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-warning">Confirmar Terminación</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>