@model List<MVC.Models.ReservaIndexViewModel>

@{
ViewData["Title"] = "Reservas";
}

<div class="container mt-4">


<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Reservas</h1>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        No hay reservas registradas.
    </div>
}
else
{
    <table class="table table-striped table-bordered align-middle">

        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Inquilino</th>
                <th>Inmueble</th>
                <th>Desde</th>
                <th>Hasta</th>
                <th>Monto por día</th>
                <th>Multa</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @item.Reserva.id_reserva
                    </td>

                    <td>
                        @item.Inquilino.nombre_completo
                    </td>

                    <td>
                        @item.Inmueble.Direccion
                    </td>

                    <td>
                        @item.Reserva.fecha_desde.ToString("dd/MM/yyyy")
                    </td>

                    <td>
                        @item.Reserva.fecha_hasta.ToString("dd/MM/yyyy")
                    </td>

                    <td>
                        $ @item.Reserva.monto_por_dia
                    </td>

                    <td>
                        $ @item.Reserva.multa
                    </td>

                    <td>
                        @item.Reserva.estado
                    </td>

                    <td>
                        <div class="d-flex gap-1">

                            <a asp-action="Editar"
                               asp-route-id="@item.Reserva.id_reserva"
                               class="btn btn-warning btn-sm">
                                Editar
                            </a>

                            <a asp-action="Cancelar"
                               asp-route-id="@item.Reserva.id_reserva"
                               class="btn btn-secondary btn-sm">
                                Cancelar
                            </a>

                            <a asp-action="Eliminar"
                               asp-route-id="@item.Reserva.id_reserva"
                               class="btn btn-danger btn-sm">
                                Eliminar
                            </a>

                        </div>
                    </td>

                </tr>
            }
        </tbody>

    </table>
}

</div>
