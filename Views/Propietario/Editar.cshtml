@model MVC.Models.Propietario

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Editar propietario</title>
</head>
<body>

    <h2>Editar propietario</h2>
    <hr />

    <form asp-action="Editar" method="post">
        <input type="hidden" name="IdPropietario" value="@Model.IdPropietario" />

        <div class="campo">
            <label>Nombre Completo</label>
            <input type="text" name="Nombre" value="@Model.Nombre" required />
        </div>

        <div class="campo">
            <label>DNI / CUIT</label>
            <input type="text" name="DniCuit" value="@Model.DniCuit" required />
        </div>

        <div class="campo">
            <label>Email</label>
            <input type="email" name="Email" value="@Model.Email" />
        </div>

        <div class="campo">
            <label>Teléfono</label>
            <input type="text" name="Telefono" value="@Model.Telefono" />
        </div>

        <button type="submit">Actualizar</button>
        <a asp-action="Index">Cancelar</a>
    </form>

</body>
</html>