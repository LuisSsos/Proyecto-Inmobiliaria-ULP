@model MVC.Models.Propietario

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Editar propietario</title>
</head>
<body>

    <h2>Editar propietario</h2>
    <hr />

    <form asp-action="Editar" method="post">
        <input type="hidden" asp-for="IdPropietario"/>

        <div class="campo">
            <label>Nombre Completo</label>
            <input type="text" asp-for="Nombre" required />
        </div>

        <div class="campo">
            <label>DNI / CUIT</label>
            <input type="text"asp-for="DniCuit" required />
        </div>

        <div class="campo">
            <label>Email</label>
            <input type="email" asp-for="Email" />
        </div>

        <div class="campo">
            <label>Teléfono</label>
            <input type="text" asp-for="Telefono" />
        </div>

        <button type="submit">Actualizar</button>
        <a asp-action="Index">Cancelar</a>
    </form>

</body>
</html>